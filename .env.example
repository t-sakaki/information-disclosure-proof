# Base Sepolia RPC endpoint (e.g. from Alchemy, Infura, or a public RPC)
CHAIN_RPC_URL=https://sepolia.base.org

# Private key of the wallet that will sign and submit attestation transactions.
# NEVER commit the real value. Use a dedicated throwaway/testnet key only.
CHAIN_PRIVATE_KEY=0xyour_private_key_here

# EAS contract address on Base Sepolia
EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021

# UID of the EAS schema used to attest disclosure requests.
# Register a schema first via https://base-sepolia.easscan.org/schema/create
EAS_SCHEMA_UID=0xyour_schema_uid_here

# SchemaRegistry contract address on Base Sepolia (used by register_schema.py)
SCHEMA_REGISTRY_ADDRESS=0x4200000000000000000000000000000000000020

# UID of the EAS schema used to record tips/endorsements/referrals
# ("address token,address referrer,uint256 amount,string comment")
# token is the zero address for native ETH, or an ERC-20 contract (e.g. USDC).
# Register via: python register_schema.py "address token,address referrer,uint256 amount,string comment"
TIP_SCHEMA_UID=0xyour_tip_schema_uid_here

# Circle's official testnet USDC contract on Base Sepolia (get test USDC at https://faucet.circle.com)
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# EAS GraphQL indexer used by leaderboard.py (defaults to Base Sepolia's public one)
EASSCAN_GRAPHQL_URL=https://base-sepolia.easscan.org/graphql

# Ethereum mainnet RPC used only for read-only ENS reverse lookups
# (ENS records live on mainnet, not Base Sepolia)
ENS_RPC_URL=https://ethereum-rpc.publicnode.com
